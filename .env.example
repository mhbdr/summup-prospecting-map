# Copy this file to .env (which is git-ignored) and adjust if needed.
# The default OpenStreetMap tile setup needs NO API key.

# Tile server (optional). Example for MapTiler: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# Vite exposes VITE_* variables to the browser, so restrict any key by HTTP referrer.
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
